{
  "name": "statuspage-telegram-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "cf-typegen": "wrangler types",
    "dev": "wrangler dev",
